# Copie este arquivo para .env e preencha com seus valores reais.
# O .env nunca é commitado (veja .gitignore); .env.example é o único
# que fica versionado, como referência de quais variáveis existem.
#
# Uso local (Oracle da FIAP, direto no host):
#   1. cp .env.example .env
#   2. preencha DB_USER, DB_PASSWORD e JWT_SECRET abaixo
#   3. .\run.ps1        (PowerShell — carrega o .env e roda a aplicação)
#
# Uso via Docker Compose: o mesmo .env é lido pelo serviço "app" através
# de env_file no docker-compose.yml, então as mesmas quatro variáveis
# valem para os dois jeitos de rodar.

# Credenciais do Oracle da FIAP (usuário RM e senha do banco)
DB_USER=
DB_PASSWORD=

# Opcional. Só defina para apontar para outro banco (ex.: container local).
# Sem isso, usa o Oracle da FIAP em oracle.fiap.com.br:1521/orcl.
# DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1

# Segredo de assinatura dos tokens JWT. Use pelo menos 32 caracteres
# (256 bits) para o algoritmo HS256 funcionar. Gere um valor aleatório,
# por exemplo: openssl rand -base64 32
JWT_SECRET=

# Usada apenas pelo docker-compose.yml, para definir a senha do container
# Oracle quando o banco também roda containerizado (não é o fluxo atual,
# que aponta direto para o Oracle da FIAP).
ORACLE_PWD=
